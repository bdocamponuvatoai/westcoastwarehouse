# Public production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://westcoastwarehouse.com

# Resend — https://resend.com (verify the sending domain first)
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="Westcoast Website <website@westcoastwarehouse.com>"
INQUIRY_TO_EMAIL=info@westcoastwarehouse.com

# Upstash Redis (either naming works; Vercel Marketplace uses KV_REST_API_*)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
